# Application
APP_TITLE=MapleSeed
PAGE_LAYOUT=wide
DEBUG=false
CORS_ALLOW_ORIGINS=*

# Local language model
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_VISION_MODEL=qwen3-vl:8b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
ENABLE_STREAMING=false

# Embeddings and vector database
# Use cuda after confirming that PyTorch and your GPU runtime are available.
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_NORMALIZE=true
VECTOR_SIZE=512
ENABLE_EMBEDDING_CACHE=true
QDRANT_PATH=./data/local_qdrant
QDRANT_COLLECTION_NAME=my_agent_db
MEMORY_COLLECTION_NAME=my_memory_db
ENABLE_MULTI_COLLECTION=true

# Optional Hugging Face authentication for faster model downloads.
# HF_TOKEN=

# Retrieval and document processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=4
ENABLE_MMR=true
MMR_FETCH_K=12
MMR_LAMBDA_MULT=0.5
ENABLE_HYBRID_SEARCH=false
ENABLE_QUERY_REWRITE=true
ENABLE_RERANKER=false
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANK_TOP_N=5
MAX_FILE_SIZE_MB=200
ENABLE_DOC_DEDUP=true
ENABLE_DOC_UPDATE=true
ENABLE_DOC_DELETE=true
ENABLE_DOC_LIST=true

# Multimodal extraction
ENABLE_OCR=true
OCR_ENGINE=rapidocr
OCR_LANGUAGE=ch
ENABLE_IMAGE_EXTRACTION=true
ENABLE_IMAGE_QA_HINT=true

# Tools and MCP
ENABLE_CALCULATOR_TOOL=false
ENABLE_FILE_TOOL=true
ENABLE_SUMMARY_TOOL=true
ENABLE_WEATHER_TOOL=true
ENABLE_WEB_SEARCH=true
ENABLE_MCP=true
MCP_CONFIG_PATH=./config/mcp_servers.json
MCP_TOOL_TIMEOUT_SECONDS=60

# Agent and memory
ENABLE_ROUTER=true
ENABLE_FALLBACK_ANSWER=true
ENABLE_TOOL_TRACE=true
AGENT_VERBOSE=true
ENABLE_SUMMARY_MEMORY=true
ENABLE_LONG_TERM_MEMORY=false
MEMORY_TOP_K=3
MAX_CHAT_TURNS=20

# UI and logs
ENABLE_SOURCE_CITATION=true
ENABLE_DOC_PANEL=true
ENABLE_SETTINGS_PANEL=true
ENABLE_HISTORY_PANEL=true
LOG_LEVEL=INFO
LOG_TO_FILE=true
